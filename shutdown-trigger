############
# FUNCTION #
############
Assert () {

    local message

    E_ASSERT_FAILED=99


    #
    # sanity checks start here
    #
    test "$#" -gt 3 && {
        cat  <<"EOF"

-------------------------
Assert: ERROR: $# > 3
-------------------------

EOF
        exit 1
    }


    test "$#" -lt 1 && {
        cat  <<"EOF"

-------------------------
Assert: ERROR: $# < 1
-------------------------

EOF
        exit 1
    }
    #
    # sanity checks end here
    #

    #
    # behave according to $#
    #
    test "$#" -eq 1 && {
        lineno="not given"
        message=
    }

    test "$#" -eq 2 && {
        echo "$2"|egrep '^[0-9][0-9]*$' 1>/dev/null 2>/dev/null && {
            # $2 is a pure (integer) number: assume it is LINENO
            lineno="$2"
            message=
        } || {
            # $2 is NOT a pure (integer) number: assume it is the failure message
            lineno="not given"
            message="$2"
        }
    } # test "$#" -eq 2

    test "$#" -eq 3 && {
        lineno="$2"
        message="$3"
    }


    #   if [ ! $1 ] 
    if `eval [ ! "$1" ]`
    then
        echo "Assertion failed:  $1"
        echo "File: $0 , line: $lineno"
        test -n "${message}" && echo "${message}"
        exit $E_ASSERT_FAILED
    fi  

    test "${back_to_xtrace}" = "true" && set -x


    return 0
} # function Assert ends here

############
# FUNCTION #
############
# Variable() { eval 'echo "$'$1'"'; return 0; }
Variable() { local _v=${1}; echo ${!_v}; return 0; }

############
# FUNCTION #
############
is_true() { StringValue "${@}"  true && return 0 || return 1; }
############
# FUNCTION #
############
is_false() { StringValue "${@}" is not true && return 0 || return 1; }

############
# FUNCTION #
############
glob () {

    local _the_command
    test $# -eq 2 || {
        echo "

ERROR:
glob function called with # of arguments =/= 2

"
        exit 1
    }
    test "$1" != "" || {
        echo "

ERROR:
glob function called with empty \$1 argument

"
        exit 1
    }
    _the_command="case \"$2\" in $1)return 0;; *)return 1;;esac"
    eval ${_the_command}
} # function glob ends here

############
# FUNCTION #
############
no_glob () {
    local _res
    _res=0
    glob "$@" && _res=1
    return ${_res}
} # function no_glob ends here


############
# FUNCTION #
############
is_def() {
    local _v
    no_glob _v $1
    Assert "$? -eq 0" ${LINENO} "
is_def: _v  is a reserved token  in this function:
please use another variable name
" # Assert    
    _v=`Variable $1`
    test -n "$_v" && return 0 || return 1
} # is_def ends here

############
# FUNCTION #
############
StringValue() {
    local _v
    test "$#" -eq 2 || test "$#" -eq 4 || {
            cat <<EOF
StringValue: \$#: $# (should be 2 or 4)
EOF
            exit 1
        }
    # sanity check
    no_glob _v $1
    Assert "$? -eq 0" ${LINENO} "
StringValue: _v  is a reserved token  in this function:
please use another variable name
" # Assert    
    _v=`Variable $1`
    # $#==2
    test "$#" -eq 2 && {
        test "$_v" = "$2" && return 0 || return 1
    }
    # $#==4
    test "$#" -eq 4 && {
        test "$2" != "is" || test "$3" != "not" && {
                cat <<EOF
StringValue: \$2: $2 (should be is)
StringValue: \$3: $3 (should be not)
EOF
                exit 1
            }
        test "$_v" != "$4" && return 0 || return 1
    } # test "$#" -eq 4
}

read configuration_file_try < <(echo "${@}"|\
                                    grep -Eso '\-c[[:space:]]?[^-[:space:]]+'|\
                                    sed -E -e's|^-c||')
configuration_file=${configuration_file_try:-/etc/shutdown-trigger.conf}


#
# do we have a configuration_file to source in the first place?
#
test -e "${configuration_file}"
Assert "$? -eq 0" ${LINENO} "

ERROR:
configuration file: |${configuration_file}|
cannot be found

" # Assert

# now we can source the configuration file
. ${configuration_file}

# run as a client also when called as ${auto_client}; this latter is
# defined in the configuration file only (ie, no command line
# available), so we must check for it here, after reading the
# configuration file
glob "${auto_client}" $(basename "${0}") && client=true
# set also this variable for convenience
server=true
${client} && server=false



#
# Make sure that the trigger device is up
# and running, and that we can poll it
#
${server} && { 
    test -z "${trigger_cmd}" && {
        cat <<EOF

ERROR:
no trigger command has been defined:
trigger command is an empty string
FIXME

EOF
        exit 1
    } # test -z "${trigger_cmd}"
    eval "${trigger_cmd}"
    no_glob 0 ${?} && {
        cat <<EOF

ERROR:
trigger command: |${trigger_cmd}|
returned non-null code at start time
Is the trigger device connected and running?
FIXME

EOF

        exit 1
    } # no_glob 0 ${?}
} # ${server} 

# getopts below will consume "${@}"; but we need a copy of it (possibly
# with some options stripped off) if we will spawn a server daemon
cmd_line_args="${@}"


# get remaining command line options
# sleep_time_default=30
# log_file_default=/var/log/shutdown-trigger.log
# pid_file_default=/var/run/shutdown-trigger.pid
# unset sleep_time_cmd_line
# unset log_file_cmd_line
# unset pid_file_cmd_line
while getopts "bCc:dD:e:fg:hL:l:P:qSs:t:V" _opt
do :
glob C "${_opt}" && dump_conf=true
glob D "${_opt}" && dot_char=${OPTARG}
glob L "${_opt}" && dots_per_line=${OPTARG}
glob P "${_opt}" && ncat_port_number=${OPTARG}
glob S "${_opt}" && dump_state=true
glob d "${_opt}" && debug=true
glob e "${_opt}" && every_n_dots=${OPTARG}
glob f "${_opt}" && foreground=true
glob g "${_opt}" && dot_group_marker=${OPTARG}
glob h "${_opt}" && print_help
glob l "${_opt}" && log_file=${OPTARG}
glob q "${_opt}" && quit=true
glob s "${_opt}" && sleep_time=${OPTARG}
glob t "${_opt}" && date_time_interval=${OPTARG}
glob V "${_opt}" && print_version=true
done # while getopts x _opt
# get remaining arguments (ie those NOT catched by getopts)
shift $((OPTIND-1))

#
# every_n_dots is declared as -i
#
test "${every_n_dots}" -le 0 && {
Die "every_n_dots: $(echo "${every_n_dots}")
Invalid value: must be a positive integer
"
} # test "${every_n_dots}" -le 0


#
# dots_per_line is declared as -i
#
test "${dots_per_line}" -le 0 && {
Die "dots_per_line: $(echo "${dots_per_line}")
Invalid value: must be a positive integer
"
} # test "${dots_per_line}" -le 0


#
# date_time_interval is declared as -i
#
test "${date_time_interval}" -le 0 && {
Die "date_time_interval: $(echo "${date_time_interval}")
Invalid value: must be a positive integer
"
} # test "${date_time_interval}" -le 0


#
# Dump configuration to stdout and exit
#
is_true dump_conf && {
dump_conf_function
exit 0
} # is_true dump_conf


#
# Dump version to stdout and exit
#
is_true print_version && {
echo ${version}
exit 0
} # is_true dump_conf


##########
# server #
##########
# run as a server (default behavior)
${server} && {


    #
    # If we have been just run by the user, but we have not yet spawned the
    # daemon in the background, check that there isn't an instance already
    # running. If so, just exit with an error
    #
    is_false BACKGROUND && {
        doit=false
        pid_file_complete=$(prepend_state_dir ${pid_file})
        test -e ${pid_file_complete} && \
            read running_pid < <(cat ${pid_file_complete}) && \
            echo "${running_pid}"|grep -Esq '^[0-9]+$' && doit=true
        ${doit} && {
            cat <<EOF


ERROR
looks like there is a shutdown-trigger
instance already running with pid
${running_pid}
running multiple shutdown-trigger
instances won't work and calls for trouble:
close the running instance and restart

EOF
            exit 1
        } # ${doit}


    } # is_false BACKGROUND

#
# Create runtime state directory
#
mkdir -p ${runtime_state_dir}

# Wait for the pid of the backgrounded process (below) to
# show up (in the ps command and/or in /proc/$$/stat)
sleep 2


#
# When the -f option was given, we do not daemonize
# Default is to daemonize ourselves (only when BACKGROUND is false,
# otherwise an infinite loop will set up)
# Note: we run the daemonized instance with "${cmd_line_args}" instead
# of "${@}", because the original "${@}" has been consumed by getopts
# above
# We pass the private (ie not available to the user) command line
# option BACKGROUND to make the spawned instance know that it is
# running in the background
#

is_false foreground && is_false BACKGROUND && {
        # touch ${runtime_state_dir}/bg.lock
        # either nohup...
        >/dev/null 2>&1 nohup ${0} ${cmd_line_args} BACKGROUND &
        # ... or simple shell background submission ?
        # ${0} "${cmd_line_args}" BACKGROUND &

        DEBUG && \
                debug_message "pid of background spawned process: |$!|"  \
                              1>>${log_file} 2>&1

        exit
    } # is_false foreground


#
# save our pid
#
pid=$$
echo ${pid} > $(prepend_state_dir ${pid_file})

#
# From here on, redirect stdout and stderr to ${log_file}
#
exec 3>&1 4>&2  # save copies of stdout and stderr
exec 1>>${log_file} 2>&1
# how to restore "normal" stdout and stderr
# exec 1>&3 2>&4 3>&- 4>&-

DEBUG && debug_message "stdin and stderr have been redirected to ${log_file}"

# It does not make sense to run: "shutdown-trigger -f &", that is:
# using the -f option and a terminating & at the same time.
# We can realize that this was the case when the two following
# variables are defined as shown:
# variable     value    meaning
# ====================================================================
# foreground   true     the -f option was given
# BACKGROUND   true     we are nevertheless running in the background (despite
#                       the -f option)
#
doit=false
is_true foreground && is_true BACKGROUND && doit=true
${doit} && {
echo "The -f option does not make sense with a terminating &"
exit 1
} # ${doit} echo "The -f option does not mak



#
# Run a ncat listening server (when DAEMONIZED)
#
DEBUG && debug_message "foreground: |${foreground}|"
is_false foreground && {
    test "${ncat_port_number}" -lt 0 && {
        # pick the first available port above 38000
        declare -i counter
        counter=0
        while lsof -i :$((38000+${counter})) 1>/dev/null 2>&1
        do :
           counter+=1
        done
        ncat_port_number=$((38000+${counter}))
    } # test "${ncat_port_number}" -lt 0
    DEBUG && debug_message "starting ncat on port ${ncat_port_number}"
    ncat localhost -l -p ${ncat_port_number} \
         -o $(prepend_state_dir ${ncat_message_file}) -k 1>/dev/null 2>&1 &
    ncat_pid=$!
    # echo "${ncat_pid}" > $(prepend_state_dir ncat.pid)
} # is_false foreground

#
# Update state file
#
update_state
update_state dump


#
# Main endless loop:
#       set date_time_interval
#       |---set dot_group_marker
#       |---set every_n_dots
#       |---set dot_counter=1
#       |---set global_dot_counter=1
#       |---set dots_per_line
#       |---dots_per_line_counter=1
#       |---the_time=current_time
#       |---print the_time (and newline)
#       |---print global_dot_counter
#       `---LOOP
#           |---LOOP
#           |   |---poll the trigger device
#           |   |---success?
#           |   |---YES
#           |   |   |---dot_counter+=1
#           |   |   |---dot_char=.
#           |   |   |---dot_counter>=every_n_dots?
#           |   |   |   |---YES
#           |   |   |   |---dot_char=dot_group_marker
#           |   |   |   `---dot_counter=1
#           |   |   |---print dot on this line
#           |   |   |---global_dot_counter+=1
#           |   |   |---sleep for sleep_time seconds
#           |   |   |---dots_per_line_counter+=1
#           |   |   `---dots_per_line_counter>=dots_per_line?
#           |   |       `---YES
#           |   |           |---newline
#           |   |           `---BREAK
#           |   |---NO
#           |   |   |---log shutdown message
#           |   |   |---shutdown remote hosts
#           |   |   `---shutdown ourselves
#           |   `---END LOOP
#           |---dot_counter=1
#           |---dots_per_line_counter=1
#           |---current_time=$(date '+%s')
#           |---current_time>=the_time+date_time_interval?
#           |   `---YES
#           |       |---print the_time (and newline)
#           |       `---the_time=current_time
#           |---print global_dot_counter (no newline)
#           `---END LOOP
#


# declare -i date_time_interval=3600*24
# dot_group_marker='|'
# declare -i every_n_dots=10
declare -i dot_counter=1
declare -i dots_per_line_counter=1
declare -i global_dot_counter=1
# declare -i dots_per_line=70
declare -i the_time=$(date "+%s")
declare -i current_time

# # uncomment when debugging
# declare -i date_time_interval=30
# dot_group_marker='|'
# declare -i every_n_dots=10
# declare -i dot_counter=1
# declare -i dots_per_line_counter=1
# declare -i global_dot_counter=1
# declare -i dots_per_line=20
# declare -i the_time=$(date "+%s")
# declare -i current_time

echo
echo "STARTING"
date --iso-8601="seconds"
printf "%8d " ${global_dot_counter}
while true
do :
   # true
   while true
   do :
      eval "${trigger_cmd}"
      result=${?}
      glob 0 ${result} && {
          dot_counter+=1
          dot=${dot_char}
          test ${dot_counter} -gt ${every_n_dots} && \
              dot=${dot_group_marker} && dot_counter=1
          printf "${dot}"
          sleep ${sleep_time} &
          wait $!
          global_dot_counter+=1
          dots_per_line_counter+=1
          test ${dots_per_line_counter} -gt ${dots_per_line} && \
              echo >>${log_file} && break
          continue
      } # glob 0 ${result}
      no_glob 0 "${result}" && {
          # exec >>${log_file} 2>&1
          # set -x
          # POWER FAILURE: SHUTDOWN ASAP!
          echo
          echo "$(date --iso-8601="seconds") SHUTDOWN"
          for ii in $(seq 0 $((${#remote_host[*]}-1)))
          do :
             echo "${remote_host[${ii}]}"
             eval "${remote_host[${ii}]}"
          done
          # housekeeping in runtime_state_dir
          rm -f $(prepend_state_dir ${pid_file})
          rm -f $(prepend_state_dir ${ncat_message_file})
          # last thing:
          echo "exec shutdown -h now"
          exec shutdown -h now
          # exit # NO-NO!! the shutdown command won't have time to complete!
      } # no_glob 0 "${result}"
   done # while true
   dot_counter=1
   dots_per_line_counter=1
   current_time=$(date "+%s")
   test ${current_time} -ge $((${the_time}+${date_time_interval})) && {
       date --iso-8601="seconds"
       the_time=${current_time}
   } #    test ${current_time} -ge $((${the_tim
   printf "%8d " ${global_dot_counter}
done # while true

  #############
} # ${server} #
  #############


##########
# client #
##########
${client} && {
DEBUG && debug_message "running as client"


# update debug value in state file
sed -E -i -e's|^ *debug=.*$|debug='${debug}'|' \
    $(prepend_state_dir ${state_file})

#
# Load state
#
. $(prepend_state_dir ${state_file})
DEBUG && debug_message "$(update_state dump)"

#
# Dump configuration to stdout and exit
#
is_true dump_conf && {
dump_conf_function
exit 0
} # is_true dump_conf

#
# sanity checks
# We need:
#  - pid
#  - ncat_port_number
#  - ncat_message_file
# properly defined
#

# pid
is_def pid
Assert "$? -eq 0" ${LINENO} "

shutdown-trigger (client):
ERROR
pid: undefined

" # Assert

# ncat_port_number
is_def ncat_port_number
Assert "$? -eq 0" ${LINENO} "

shutdown-trigger (client):
ERROR
ncat_port_number: undefined

" # Assert

# ncat_message_file
is_def ncat_message_file
Assert "$? -eq 0" ${LINENO} "

shutdown-trigger (client):
ERROR
ncat_message_file: undefined

" # Assert



############
# FUNCTION #
############
send () {
# send to the listening ncat
echo "${1}"|ncat localhost ${ncat_port_number}
# SIGUSR1 (10) is trapped by the server code and will call the sigusr1
# function which parses the messages from the client and takes
# corresponding actions
kill -10 "${pid}"
return 0
} # function send ends here


#
# quit
#

DEBUG && debug_message "sending quit"
${quit} && send "quit"

#
# dump current state to stdout
#
${dump_state} && update_state dump

  ##########
} # client #
  ##########
